<%layout("/layouts/boilerplate")%>
<style>
    .box{
        max-height: 400px !important;
        margin-top: 20px;
        margin-bottom: 20px;
        border: none;
        border-radius: 1rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        margin-left: 0;
        margin-right: 0%;
    }

    .img-fluid{
        width: 100%;
        height: 100%;
        object-fit: cover !important;
        border-top-left-radius: 1rem;
        border-bottom-left-radius: 1rem;
        margin-left: -1rem;
    }

    .col-md-6{
        height: 400px;
    }
</style>

<body>
    <div class="row box">
        <div class="col-md-6" style="object-fit: cover !important;">
            <img src="/images/signup.jpg" class="img-fluid"/>
        </div>
        <div class="col-md-6">
            <h3>Login</h3>
            <form action="/login" method="POST" class="needs-validation" novalidate>
                <div>
                    <label for="username" class="form-label">Username: </label>
                    <input type="text" name="username" id="username" placeholder="Enter a username" class="form-control" required>
                </div><br>
                <div>
                    <label for="password" class="form-label">Password: </label>
                    <input type="password" name="password" id="password"  class="form-control" required>
                    <div class="invalid-feedback">Enter a valid password</div>
                </div><br>
                <button class="btn btn-dark">Login</button>
            </form>
        </div>
    </div>
</body>